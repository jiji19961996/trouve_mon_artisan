{
  "name": "trouve-ton-artisan",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:gateway\" \"npm:dev:web\"",
    "dev:api": "node --env-file=.env --watch server/api.js",
    "dev:gateway": "node --env-file=.env --watch server/gateway.js",
    "dev:web": "vite --config frontend/vite.config.js",
    "build": "vite build --config frontend/vite.config.js",
    "start": "node --env-file=.env server/gateway.js",
    "test": "node --test tests/*.test.js",
    "start:api": "node --env-file=.env server/api.js"
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "mysql2": "^3.15.3",
    "nodemailer": "^10.5.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.6",
    "sequelize": "^6.37.7",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "sass": "^1.94.0",
    "supertest": "^7.1.4",
    "vite": "^7.2.2"
  },
  "overrides": {
    "sequelize": {
      "uuid": "^11.1.1"
    }
  }
}
